<UserControl x:Class="SudokuSolver.Wpf.Views.SudokuGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SudokuSolver.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SudokuGridViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeaderStyle}" />

        <Border BorderBrush="{StaticResource BoxLineBrush}" BorderThickness="2" Background="White"
                HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="9" Columns="9" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CellViewModel}">
                        <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,1,1"
                                Width="34" Height="34">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <!-- Thicken the right and bottom edges to mark the 3x3 boxes. -->
                                        <DataTrigger Binding="{Binding IsBoxEdgeRight}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BoxLineBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,3,1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBoxEdgeBottom}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BoxLineBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,1,3" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBoxEdgeRight}" Value="True" />
                                                <Condition Binding="{Binding IsBoxEdgeBottom}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="{StaticResource BoxLineBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,3,3" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding DisplayText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="18">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- Solver filled cells are the default; givens are overridden below. -->
                                        <Setter Property="Foreground" Value="{StaticResource SolvedCellBrush}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGiven}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GivenCellBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Given" FontWeight="Bold" Foreground="{StaticResource GivenCellBrush}" />
            <TextBlock Text="  /  " Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Filled by solver" Foreground="{StaticResource SolvedCellBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
